# =============================================================================
# juniper-cascor-worker Environment Variables
# Copy this file to .env and customize as needed.
# =============================================================================

# CasCor training manager connection
CASCOR_MANAGER_HOST=127.0.0.1
CASCOR_MANAGER_PORT=50000
# Required in --legacy mode; there is no default, and it must match the manager's key.
# Never use a published sample value. Generate one, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
CASCOR_AUTHKEY=
CASCOR_NUM_WORKERS=1
CASCOR_MP_CONTEXT=forkserver
